# Stratis backend — copy to .env and fill in.
# Every variable the server actually reads is listed here. If a setting is not
# in this file, it does not exist: the operator allowlist was live in the code
# for weeks while being documented nowhere a deploy would pick it up, which is
# why the console was unreachable in production.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Postgres. Without it the server falls back to a local file database, which is
# fine for a laptop and wrong for anything else.
DATABASE_URL=postgresql://user:password@localhost:5432/stratis
# REQUIRED in production — the server refuses to boot without it. Any long
# random string; changing it signs everyone out.
JWT_SECRET=change-me-to-something-random
JWT_EXPIRES_IN=7d
# A guest token dies with the meeting it was minted for. Hours, not days.
GUEST_TOKEN_EXPIRES_IN=12h
# Comma-separated. The browser origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ─── The Stratis team's own access ───────────────────────────────────────────
# Comma-separated email addresses. An account whose email is on this list sees
# the operator console: cross-workspace usage, and beta codes.
#
# It is NOT a role — the check reads the email from the database row behind the
# token, so it cannot be set by a request, and removing an address takes effect
# on that account's very next call. It reaches usage and codes only; nothing
# here can open anybody's meeting.
#
# Empty means nobody is an operator. That is the safe default, and it is also
# what makes /admin answer 403 on a fresh deploy.
PLATFORM_ADMIN_EMAILS=you@example.com

# ─── AI ──────────────────────────────────────────────────────────────────────
# gemini | groq | openai | mock. Mock is SILENT — a deploy with this unset looks
# healthy until the first meeting produces [mock transcript].
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Retried on 500/502/503/504 (model overloaded). NOT on 429 — that is the
# project's quota, and the fallback shares it. See docs/DECISIONS.md §1.
GEMINI_MODEL_FALLBACK=gemini-1.5-flash
# Paces every Gemini request in the process, not just one meeting's.
GEMINI_MIN_REQUEST_INTERVAL_MS=1200
# Paces one session's live-card loop. Rows arriving inside the gap coalesce.
AI_MIN_CALL_INTERVAL_MS=8000

# ─── Speech to text ──────────────────────────────────────────────────────────
# google | mock. Also silent when mocked — /api/health reports what resolved.
STT_PROVIDER=mock
# Path to the service-account JSON when STT_PROVIDER=google.
GOOGLE_APPLICATION_CREDENTIALS=./STT-service.key.json

# ─── Sign in with Google (optional) ──────────────────────────────────────────
# Leave empty and the login screen simply does not offer the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
