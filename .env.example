# ─────────────────────────────────────────────────────────────────────────────
# Stratis — environment template
# Copy to .env at the REPO ROOT (one file serves backend + Vite frontend).
# Load order (backend/src/config/env.ts): .env.$NODE_ENV first, then .env.
# dotenv does not override already-set vars, so the first file wins.
# The app runs with NO keys at all: AI falls back to a deterministic mock and
# STT falls back to the browser Web Speech API.
# Never commit real values — .env / .env.* are gitignored, this file is not.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime (backend) ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001                                    # Express + WebSocket
CLIENT_ORIGIN=http://localhost:5173          # CORS allowlist, comma-separated
APP_URL=                                     # OAuth/invite landing; defaults to first CLIENT_ORIGIN
APP_VERSION=                                 # stamped on telemetry; Render sets RENDER_GIT_COMMIT

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. Required in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# SSL is auto-on unless host is localhost/127.0.0.1/*.railway.internal.
# Set to true/false only to override that.
DATABASE_SSL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production — backend refuses to boot without it.
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d
GUEST_TOKEN_EXPIRES_IN=12h
# Comma-separated emails allowed to hit platform-admin routes. Empty = nobody.
PLATFORM_ADMIN_EMAILS=

# ── Google OAuth (sign-in) ───────────────────────────────────────────────────
# Sign-in stays disabled until BOTH id and secret are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered on the Google Cloud OAuth client exactly.
# Defaults to http://localhost:$PORT/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── AI provider ──────────────────────────────────────────────────────────────
# AI_PROVIDER = gemini | groq | ollama | typhoon | mock   (default: groq)
# Empty key on a hosted provider = automatic mock fallback, app still responds.
AI_PROVIDER=gemini
AI_TIMEOUT_MS=10000
# Min gap between live-card AI calls per session (ms). Caps requests/min so a
# busy meeting stays under provider quota. 15000 ≈ 4 calls/min.
AI_MIN_CALL_INTERVAL_MS=15000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Retried once when GEMINI_MODEL returns 500/503 (Google overload).
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite
GEMINI_MIN_REQUEST_INTERVAL_MS=4000

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

TYPHOON_API_KEY=

# ── Speech-to-text — Google Chirp 2 (Thai+English code-switching) ────────────
# STT_PROVIDER = google | mock   (default: mock)
STT_PROVIDER=google
STT_TIMEOUT_MS=15000
# Chirp 2 (Speech v2) uses OAuth2 service account, NOT an API key.
# Pick ONE of the next three:
#   1. absolute path to the service-account JSON (forward slashes OK on Windows)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.key.json
#   2. same thing, alternate name
STT_GOOGLE_KEY_FILE=
#   3. the whole JSON inline — use this on Render/Vercel where there is no disk
GOOGLE_SERVICE_ACCOUNT_JSON=
# Legacy v1 API key. Unused by Chirp 2, kept for fallback only.
GOOGLE_API_KEY=

# Chirp 2 is region-scoped — pick a region serving chirp_2 + th-TH.
STT_LOCATION=us-central1
STT_MODEL=chirp_2
STT_GOOGLE_PROJECT_ID=
# Multiple BCP-47 codes are what actually enable code-switching; a single
# th-TH forces English speech through a Thai-only recogniser and returns
# garbage. First code is primary.
STT_LANGUAGES=th-TH,en-US

# ── Frontend (Vite) — must be VITE_-prefixed, baked in at BUILD time ─────────
# On Vercel these live in the project env, not in this file.
VITE_API_BASE=http://localhost:3001      # required in prod builds
VITE_WS_BASE=                            # defaults to VITE_API_BASE with http→ws
VITE_STT_STREAMING=1                     # "0" disables streaming STT
VITE_MOCK=                               # "1" installs the offline fetch mock
